#pragma once
#include "runtime/ByteCode.hpp"
#include "runtime/Instruction.hpp"
#include "runtime/value/value.hpp"

#include <iostream>
#include <stdexcept>
#include <vector>

//////////////////////////////////////////////////////
// STACK FRAME (REGISTERS)
//////////////////////////////////////////////////////

struct ValueArena {
  std::vector<Value> buffer;
  size_t next = 0;

  Value *alloc(const Value &v) {
    if (next >= buffer.size()) buffer.resize(buffer.size() + 1024);
    buffer[next] = v;
    return &buffer[next++];
  }

  void reset() { next = 0; }
};

struct StackFrame {
  size_t return_ip = 0;
  uint32_t function_idx = 0;
  size_t ip = 0;
  std::vector<Value *> registers;
};

struct AylaVM {
  std::vector<StackFrame> call_stack;

  const GenModule *module = nullptr;
  const FunctionValue *current_function = nullptr;
  ValueArena arena;

  void execute(const GenModule &m) {
    module = &m;
    if (module->functions.empty()) return;

    // 1️⃣ pega o top-level/main
    size_t main_index = module->functions.size() - 1;
    current_function = &module->functions[main_index];

    // 2️⃣ cria frame
    StackFrame frame;
    frame.function_idx = main_index;
    frame.registers.resize(current_function->local_count, nullptr);
    call_stack.push_back(std::move(frame));

    // 3️⃣ executa apenas o top-level
    run();
  }

  //////////////////////////////////////////////////////
  // RUN LOOP
  //////////////////////////////////////////////////////
  void run() {

    while (!call_stack.empty()) {
      auto &frame = call_stack.back();
      const FunctionValue &func = module->functions[frame.function_idx];

      if (frame.ip >= func.code.size()) {

        auto ret = frame.registers[0];
        call_stack.pop_back();
        if (call_stack.empty()) break;

        auto &caller = call_stack.back();
        caller.registers[0] = ret;
        continue;
      }

      const Instruction &instr = func.code[frame.ip++];

      switch (instr.op) {

      case OpCode::LOADK: frame.registers[instr.A] = arena.alloc(module->constants[instr.K]); break;

      case OpCode::MOVE: frame.registers[instr.A] = frame.registers[instr.B]; break;

      case OpCode::ADD: {
        std::cout << "ADD: R[" << instr.A << "] = R[" << instr.B << "] + R[" << instr.C << "]\n";
        frame.registers[instr.A] = arena.alloc(Value(frame.registers[instr.B]->get_number() + frame.registers[instr.C]->get_number()));
        break;
      }
      case OpCode::SUB: frame.registers[instr.A] = arena.alloc(Value(frame.registers[instr.B]->get_number() - frame.registers[instr.C]->get_number())); break;
      case OpCode::MUL: frame.registers[instr.A] = arena.alloc(Value(frame.registers[instr.B]->get_number() * frame.registers[instr.C]->get_number())); break;
      case OpCode::DIV: frame.registers[instr.A] = arena.alloc(Value(frame.registers[instr.B]->get_number() / frame.registers[instr.C]->get_number())); break;

      case OpCode::CALL: {
        auto *fn_val = frame.registers[instr.B];
        if (!fn_val || !fn_val->is_user_function()) throw std::runtime_error("Invalid function in CALL");

        auto user_fn = fn_val->get_user_function();
        const FunctionValue &fn = module->functions[user_fn.bytecode_index];

        StackFrame new_frame;
        new_frame.return_ip = frame.ip;
        new_frame.function_idx = user_fn.bytecode_index;
        new_frame.registers.resize(fn.local_count, nullptr);

        // inicializa registradores
        for (auto &r : new_frame.registers) r = arena.alloc(Value::Null());

        // copia argumentos do frame atual
        for (uint16_t i = 0; i < instr.C; ++i) new_frame.registers[i] = frame.registers[instr.B + 1 + i];

        call_stack.push_back(std::move(new_frame));
        break;
      }
      case OpCode::RETURN: {
        auto ret = frame.registers[instr.A];
        call_stack.pop_back();
        if (!call_stack.empty()) call_stack.back().registers[instr.A] = ret;
        break;
      }
      }
    }
  }
};
