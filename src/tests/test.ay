import debug.console

val n: number = 1000000 

funct fib(x: number) {
  if x < 2 {
    return x
  }
  return fib(x - 1) + fib(x - 2)
}

funct factorial(x: number) {
  if x <= 1 {
    return 1
  }
  return x * factorial(x - 1)
}

console.time("complex math test")

val sum: number = 0
val i: number = 1

while i <= 30 {
  val f: number = factorial(i)
  val fib_val: number = fib(i)
  
  val sum: number = sum + f + fib_val
  
  i = i + 1
}

console.timeEnd("complex math test")
