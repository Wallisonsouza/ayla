module capabilities

export Add: cap<T> {
    add: fun(other: T) -> T
}

export Sub: cap<T> {
    sub: fun(other: T) -> T
}

export Mul: cap<T> {
    mul: fun(other: T) -> T
}

export Div: cap<T> {
    div: fun(other: T) -> T
}

export Eq: cap<T> {
    eq: fun(other: T) -> bool
}

export Ord: cap<T> {
    cmp: fun(other: T) -> int
}