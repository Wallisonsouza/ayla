export extern int: type
export extern uint: type

export extern int8: type
export extern int16: type
export extern int32: type
export extern int64: type

export extern uint8: type
export extern uint16: type
export extern uint32: type
export extern uint64: type

export extern f32: type
export extern f64: type

export extern bool: type
export extern char: type
export extern string: type
export extern void: type

export extern array: type<T>



export extern map: type<K, V>
export extern set: type<T>
export extern ref: type<T>



export Add: cap<T> {
    add: fun(a: T, b: T) -> T
}

export Sub: cap<T> {
    sub: fun(a: T, b: T) -> T
}

export Mul: cap<T> {
    mul: fun(a: T, b: T) -> T
}

export Div: cap<T> {
    div: fun(a: T, b: T) -> T
}


int: impl Add<int> {
    add: fun(a: int, b: int) -> int {
        return a + b
    }
}

int: impl Sub<int> {
    sub: fun(a: int, b: int) -> int {
        return a - b
    }
}

int: impl Mul<int> {
    mul: fun(a: int, b: int) -> int {
        return a * b
    }
}

int: impl Div<int> {
    div: fun(a: int, b: int) -> int {
        return a / b
    }
}