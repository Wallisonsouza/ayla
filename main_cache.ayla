import glfw
import io
import convert

if !glfw.init() {
  io.print("GLFW init error")
}

val win = glfw.create_window(400, 600, "test")

glfw.make_context_current(win)


while !glfw.window_should_close(win) {

  glfw.swap_buffers(win)
  glfw.poll_events()
}

glfw.destroy_window(win)
glfw.terminate()